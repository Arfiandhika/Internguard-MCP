{
  "name": "internguard-mcp",
  "version": "0.1.0",
  "description": "InternGuard: MCP server for internship safety and student eligibility checks",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:watch": "tsc -p tsconfig.json --noEmit --watch",
    "inspect": "npm run build && npx -y @modelcontextprotocol/inspector node dist/index.js",
    "inspect:dev": "npx -y @modelcontextprotocol/inspector tsx src/index.ts",
    "inspect:cli": "npm run build && npx -y @modelcontextprotocol/inspector --cli node dist/index.js --method tools/list",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "approval": "node dist/approval/cli.js",
    "approval:dev": "tsx src/approval/cli.ts",
    "demo:prepare": "npm run build && tsx scripts/demo.ts prepare",
    "demo:execute": "tsx scripts/demo.ts execute",
    "demo:status": "tsx scripts/demo.ts status",
    "check:company": "tsx scripts/check-company.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "better-sqlite3": "12.11.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
